#include <iostream>
#include <string>
using namespace std;

class PersonalDetails {
protected:
    string name;
    int age;
public:
    void getPersonalDetails() {
        cout << "Enter employee name: ";
        getline(cin, name);
        cout << "Enter employee age: ";
        cin >> age;
    }
};

class DepartmentDetails {
protected:
    string department;
    int joiningYear;
public:
    void getDepartmentDetails() {
        cin.ignore();
        cout << "Enter department name: ";
        getline(cin, department);
        cout << "Enter joining year: ";
        cin >> joiningYear;
    }
};

class Employee : public PersonalDetails, public DepartmentDetails {
public:
    void displayDetails() {
        int currentYear;
        cout << "Enter current year: ";
        cin >> currentYear;

        cout << "\nEmployee Details" << endl;
        cout << "Name: " << name << endl;
        cout << "Age: " << age << endl;
        cout << "Department: " << department << endl;
        cout << "Joining Year: " << joiningYear << endl;
        cout << "Total Years of Service: "
             << currentYear - joiningYear << endl;
    }
};

int main() {
    Employee e;
    e.getPersonalDetails();
    e.getDepartmentDetails();
    e.displayDetails();
    return 0;
}
