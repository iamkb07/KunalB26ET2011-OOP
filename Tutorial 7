#include <iostream>
#include <cstring>

class String {
private:
    char* str;

public:
    
    String(const char* val = "") {
        if (val == nullptr) {
            str = new char[1];
            str[0] = '\0';
        } else {
            str = new char[std::strlen(val) + 1];
            std::strcpy(str, val);
        }
    }

    ~String() {
        delete[] str;
    }

    void Accept() {
        char temp[1000];
        std::cout << "Enter a string: ";
        std::cin.getline(temp, 1000);

        delete[] str;

        str = new char[std::strlen(temp) + 1];
        std::strcpy(str, temp);
    }

    void Display() const {
        std::cout << "String: " << str << std::endl;
    }
};

int main() {
  
    std::cout << "--- Initializing obj1 with parameterized constructor ---" << std::endl;
    String obj1("Hello, World!");
    obj1.Display();

    std::cout << "\n--- Creating obj2 and taking user input ---" << std::endl;
    String obj2;
    obj2.Accept();
    obj2.Display();

    return 0;
}
