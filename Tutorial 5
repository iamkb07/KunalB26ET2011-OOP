#include <iostream>
using namespace std;

int multiply(int a, int b) {
    return a * b;
}

int multiply(int a, int b, int c) {
    return a * b * c;
}

int main() {
    int num1 = 5, num2 = 10, num3 = 4;

    cout << "Multiplication of two integers (" << num1 << " * " << num2 << "): " 
         << multiply(num1, num2) << endl;

    cout << "Multiplication of three integers (" << num1 << " * " << num2 << " * " << num3 << "): " 
         << multiply(num1, num2, num3) << endl;

    return 0;
}
