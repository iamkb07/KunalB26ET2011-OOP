#include <iostream>
using namespace std;

int main() {
    int age;

    cout << "Enter your age: ";
    cin >> age;

    try {
        if (age < 0 || age > 120) {
            throw age;
        }
        cout << "Valid age: " << age << endl;
    }
    catch (int a) {
        cout << "Exception caught: Invalid age " << a << endl;
    }

    return 0;
}
